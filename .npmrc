# 新增 workspace 包时 pnpm 需要重建 node_modules；非 TTY（AI/CI）环境下默认会中止并报
# ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY。关掉这个交互确认。
confirm-modules-purge=false

# React Native 生态的 peerDependencies 普遍滞后（例如尚未声明支持 React 19），
# 严格模式会让安装直接失败。保持宽松，但每次安装后要留意 pnpm 打印的 peer 警告。
strict-peer-dependencies=false

# 不自动执行依赖的 postinstall 脚本（例如 playwright 会下载上百 MB 的浏览器）。
# 需要时对单个包显式放行。
# enable-pre-post-scripts=false
